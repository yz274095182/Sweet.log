.tools-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(236, 248, 241, 0.95), rgba(247, 250, 247, 0.64) 44%, rgba(247, 250, 247, 0) 66%),
    linear-gradient(180deg, #f4faf6 0%, #f8fbf8 48%, #ffffff 100%);
  box-sizing: border-box;
}

.tools-header {
  padding: 10rpx 2rpx 18rpx;
}

.tools-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.tools-title {
  color: #111713;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.tools-subtitle {
  max-width: 560rpx;
  margin-top: 6rpx;
  color: #6d7870;
  font-size: 24rpx;
  line-height: 1.5;
}

.tools-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #2f7d59;
  background: #e8f5ee;
  font-size: 22rpx;
  font-weight: 800;
}

.tool-card {
  display: flex;
  align-items: center;
  min-height: 188rpx;
  padding: 26rpx;
  border: 1rpx solid #dfeae3;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(31, 42, 36, 0.06);
  box-sizing: border-box;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #e8f5ee;
}

.tool-icon-image {
  width: 46rpx;
  height: 46rpx;
}

.tool-content {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.tool-title {
  color: #111713;
  font-size: 34rpx;
  font-weight: 900;
}

.tool-desc {
  margin-top: 8rpx;
  color: #6d7870;
  font-size: 25rpx;
  line-height: 1.45;
}

.tool-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tool-tags text {
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #2f7d59;
  background: #edf8f2;
  font-size: 21rpx;
  font-weight: 800;
}

.tool-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
}

.tools-notice {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e3eadf;
  border-radius: 18rpx;
  color: #6a756d;
  background: rgba(242, 248, 244, 0.92);
  font-size: 24rpx;
  line-height: 1.55;
}
